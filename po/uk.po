msgid "Save the password in the system keyring"
msgstr "Зберегти пароль у системній в'язці ключів"

msgid "Save the password in the keyring (not available in this build: kept until the program closes)"
msgstr "Зберегти пароль у в'язці ключів (у цій збірці недоступно: зберігається до закриття програми)"

msgid "Leave the password empty to keep the saved one."
msgstr "Залиште пароль порожнім, щоб зберегти попередній."

msgid "Reverse PTZ left / right"
msgstr "Реверс PTZ вліво / вправо"

msgid "Live view (RTSP)"
msgstr "Живий перегляд (RTSP)"

msgid "Use the sub stream when several cameras are shown"
msgstr "Використовувати додатковий потік, коли показано кілька камер"

msgid "RTSP port"
msgstr "Порт RTSP"

msgid "Channel"
msgstr "Канал"

msgid "Main stream number"
msgstr "Номер основного потоку"

msgid "Sub stream number"
msgstr "Номер додаткового потоку"

msgid "RTSP address"
msgstr "Адреса RTSP"

msgid "Delete camera"
msgstr "Видалити камеру"

msgid "Cancel"
msgstr "Скасувати"

msgid "Save"
msgstr "Зберегти"

