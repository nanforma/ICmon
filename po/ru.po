msgid "The password contains non-ASCII characters (wrong keyboard layout?). Nothing was saved."
msgstr "Пароль содержит не-ASCII символы (неверная раскладка?). Ничего не сохранено."

msgid "Enter the password, or tick \"The camera has no password\"."
msgstr "Введите пароль или отметьте «У камеры нет пароля»."

msgid "Click again to delete"
msgstr "Нажмите ещё раз для удаления"

msgid "Search failed: "
msgstr "Поиск не удался: "

msgid "No cameras answered. Not every camera replies to the search, and a router may block it: enter the address by hand."
msgstr "Камеры не ответили. Не каждая камера отвечает на поиск, роутер тоже может его блокировать: введите адрес вручную."

msgid "Click a camera in the list to fill in its address."
msgstr "Нажмите на камеру в списке, чтобы подставить её адрес."

msgid "(no name)"
msgstr "(без имени)"

msgid "Searching…"
msgstr "Поиск…"

msgid "Camera settings"
msgstr "Настройки камеры"

msgid "Add camera"
msgstr "Добавить камеру"

msgid "Search"
msgstr "Поиск"

msgid "Search for cameras on the local network"
msgstr "Поиск камер в локальной сети"

msgid "Name"
msgstr "Имя"

msgid "Address"
msgstr "Адрес"

msgid "Camera address"
msgstr "Адрес камеры"

msgid "Port (archive)"
msgstr "Порт (архив)"

msgid "User"
msgstr "Пользователь"

msgid "Password"
msgstr "Пароль"

msgid "The camera has no password"
msgstr "У камеры нет пароля"

msgid "Save the password in the system keyring"
msgstr "Сохранить пароль в системной связке ключей"

msgid "Save the password in the keyring (not available in this build: kept until the program closes)"
msgstr "Сохранить пароль в связке ключей (в этой сборке недоступно: хранится до закрытия программы)"

msgid "Leave the password empty to keep the saved one."
msgstr "Оставьте пароль пустым, чтобы сохранить прежний."

msgid "Reverse PTZ left / right"
msgstr "Реверс PTZ влево / вправо"

msgid "Live view (RTSP)"
msgstr "Живой просмотр (RTSP)"

msgid "Use the sub stream when several cameras are shown"
msgstr "Использовать дополнительный поток, когда показано несколько камер"

msgid "RTSP port"
msgstr "Порт RTSP"

msgid "Channel"
msgstr "Канал"

msgid "Main stream number"
msgstr "Номер основного потока"

msgid "Sub stream number"
msgstr "Номер дополнительного потока"

msgid "RTSP address"
msgstr "Адрес RTSP"

msgid "Delete camera"
msgstr "Удалить камеру"

msgid "Cancel"
msgstr "Отмена"

msgid "Save"
msgstr "Сохранить"

