msgid "The password contains non-ASCII characters (wrong keyboard layout?). Nothing was saved."
msgstr "Пароль містить не-ASCII символи (невірна розкладка?). Нічого не збережено."

msgid "Enter the password, or tick \"The camera has no password\"."
msgstr "Введіть пароль або позначте «Камера без пароля»."

msgid "Click again to delete"
msgstr "Натисніть ще раз для видалення"

msgid "Search failed: "
msgstr "Пошук не вдався: "

msgid "No cameras answered. Not every camera replies to the search, and a router may block it: enter the address by hand."
msgstr "Камери не відповіли. Не кожна камера відповідає на пошук, роутер теж може його блокувати: введіть адресу вручну."

msgid "Click a camera in the list to fill in its address."
msgstr "Натисніть на камеру в списку, щоб підставити її адресу."

msgid "(no name)"
msgstr "(без імені)"

msgid "Searching…"
msgstr "Пошук…"

msgid "Camera settings"
msgstr "Налаштування камери"

msgid "Add camera"
msgstr "Додати камеру"

msgid "Search"
msgstr "Пошук"

msgid "Search for cameras on the local network"
msgstr "Пошук камер у локальній мережі"

msgid "Name"
msgstr "Ім'я"

msgid "Address"
msgstr "Адреса"

msgid "Camera address"
msgstr "Адреса камери"

