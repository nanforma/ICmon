msgstr "Світло камери вкл / викл (показує те, що зроблено в цьому сеансі)"

msgid "Save the current frame (PNG, full camera resolution)"
msgstr "Зберегти поточний кадр (PNG, повна роздільність камери)"

msgid "Sound on / off (off by default)"
msgstr "Звук вкл / викл (типово вимкнено)"

msgid "Output volume"
msgstr "Гучність"

msgid "Connecting…"
msgstr "Підключення…"

msgid "Connection lost, reconnecting ("
msgstr "З'єднання втрачено, перепідключення ("

msgid "(automatic reconnection gave up; press the restart button)"
msgstr "(автоматичне перепідключення припинено; натисніть кнопку перезапуску)"

msgid "No folder for saved media is set."
msgstr "Теку для збереження не задано."

msgid "Cannot create the folder "
msgstr "Не вдалося створити теку "

msgid "Frame saved: "
msgstr "Кадр збережено: "

