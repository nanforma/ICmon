msgstr "Свет камеры вкл / выкл (показывает то, что сделано в этом сеансе)"

msgid "Save the current frame (PNG, full camera resolution)"
msgstr "Сохранить текущий кадр (PNG, полное разрешение камеры)"

msgid "Sound on / off (off by default)"
msgstr "Звук вкл / выкл (по умолчанию выключен)"

msgid "Output volume"
msgstr "Громкость"

msgid "Connecting…"
msgstr "Подключение…"

msgid "Connection lost, reconnecting ("
msgstr "Соединение потеряно, переподключение ("

msgid "(automatic reconnection gave up; press the restart button)"
msgstr "(автоматическое переподключение прекращено; нажмите кнопку перезапуска)"

msgid "No folder for saved media is set."
msgstr "Папка для сохранения не задана."

msgid "Cannot create the folder "
msgstr "Не удалось создать папку "

msgid "Frame saved: "
msgstr "Кадр сохранён: "

