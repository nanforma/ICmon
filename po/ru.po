msgstr "Не удалось сохранить кадр: "

msgid "Fold / unfold"
msgstr "Свернуть / развернуть"

msgid "Up"
msgstr "Вверх"

msgid "Left"
msgstr "Влево"

msgid "Right"
msgstr "Вправо"

msgid "Down"
msgstr "Вниз"

msgid "Zoom in"
msgstr "Приблизить"

msgid "Zoom out"
msgstr "Отдалить"

msgid "Saved positions"
msgstr "Сохранённые позиции"

msgid "Add a saved position"
msgstr "Добавить позицию"

msgid "Position number (1-16)"
msgstr "Номер позиции (1-16)"

msgid "Save position"
msgstr "Сохранить позицию"

msgid "Remove the selected saved position from the list"
msgstr "Убрать выбранную позицию из списка"

msgid "Number of cameras on the screen"
msgstr "Количество камер на экране"

msgid "Restart the streams of the cameras shown (use after a failure)"
msgstr "Перезапустить потоки показанных камер (после сбоя)"

msgid "Live View"
msgstr "Живой просмотр"

msgid "Playback"
msgstr "Архив"

