msgstr "Не вдалося зберегти кадр: "

msgid "Fold / unfold"
msgstr "Згорнути / розгорнути"

msgid "Up"
msgstr "Вгору"

msgid "Left"
msgstr "Вліво"

msgid "Right"
msgstr "Вправо"

msgid "Down"
msgstr "Вниз"

msgid "Zoom in"
msgstr "Наблизити"

msgid "Zoom out"
msgstr "Віддалити"

msgid "Saved positions"
msgstr "Збережені позиції"

msgid "Add a saved position"
msgstr "Додати позицію"

msgid "Position number (1-16)"
msgstr "Номер позиції (1-16)"

msgid "Save position"
msgstr "Зберегти позицію"

msgid "Remove the selected saved position from the list"
msgstr "Прибрати вибрану позицію зі списку"

msgid "Number of cameras on the screen"
msgstr "Кількість камер на екрані"

msgid "Restart the streams of the cameras shown (use after a failure)"
msgstr "Перезапустити потоки показаних камер (після збою)"

msgid "Live View"
msgstr "Живий перегляд"

msgid "Playback"
msgstr "Архів"

